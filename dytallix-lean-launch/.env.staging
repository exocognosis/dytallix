# STAGING template (updated)
NODE_ENV=staging

VITE_API_URL=https://api.staging.dytallix.com
VITE_FAUCET_API_URL=https://api.staging.dytallix.com/api/faucet

VITE_LCD_HTTP_URL=https://lcd.staging.dytallix.com
VITE_RPC_HTTP_URL=https://rpc.staging.dytallix.com
VITE_RPC_WS_URL=wss://rpc.staging.dytallix.com/websocket
VITE_CHAIN_ID=dytallix-testnet-1
CHAIN_PREFIX=dytallix

ALLOWED_ORIGINS=https://staging.dytallix.com

LOG_LEVEL=debug
LOG_DIR=./logs
LOG_ROTATE_DAYS=3

ENABLE_SEC_HEADERS=1
ENABLE_CSP=1
