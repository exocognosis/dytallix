# Dytallix Staging Environment
# Choose either hosted testnet endpoints or local/docker ones.

# Hosted Testnet (public) - uncomment to use
VITE_LCD_HTTP_URL=https://lcd-testnet.dytallix.com
VITE_RPC_HTTP_URL=https://rpc-testnet.dytallix.com
VITE_RPC_WS_URL=wss://rpc-testnet.dytallix.com/websocket
VITE_CHAIN_ID=dytallix-testnet-1

# Local / Docker (example) - comment out above and uncomment below if running locally
# VITE_LCD_HTTP_URL=http://178.156.187.81:1317
# VITE_RPC_HTTP_URL=http://178.156.187.81:26657
# VITE_RPC_WS_URL=ws://178.156.187.81:26657/websocket
# VITE_CHAIN_ID=dockerchain

# Faucet API (frontend will default to /api/faucet if not set)
VITE_FAUCET_API_URL=http://localhost:8787/api/faucet

# Optional test mnemonic (DO NOT USE IN PROD)
# TEST_MNEMONIC="replace with funded test wallet (never commit real secrets)"

# Feature Flags / Tuning
VITE_PQC_ENABLED=true
VITE_PQC_ALGO=dilithium
VITE_LOG_LEVEL=info
VITE_DEV_MODE=true
