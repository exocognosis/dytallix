// This is your Prisma schema file for QuantumVault MVP
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthSource {
  LOCAL
  ACTIVE_DIRECTORY
  AZURE_AD
  OKTA
  ENTERPRISE_IAM
}

enum ClearanceLevel {
  L0_INTERNAL
  L1_SENSITIVE
  L2_CONFIDENTIAL
  L3_RESTRICTED
  L4_CRITICAL
}

enum ClassificationLevel {
  L0_INTERNAL
  L1_SENSITIVE
  L2_CONFIDENTIAL
  L3_RESTRICTED
  L4_CRITICAL
}

enum DeviceComplianceStatus {
  UNKNOWN
  MANAGED
  HARDENED
  SECURE_WORKSTATION
  NON_COMPLIANT
}

enum NetworkZone {
  UNKNOWN
  INTERNAL
  VPN
  RESTRICTED
  SECURE_ENCLAVE
  EXTERNAL
}

enum EncryptionState {
  UNENCRYPTED
  PQC_WRAPPED
  SESSION_REWRAPPED
  DESTROYED
}

enum AssetLifecycleState {
  DISCOVERED
  CLASSIFIED
  ENCRYPTED
  STORED
  AVAILABLE
  ACCESS_REQUESTED
  ACCESS_GRANTED
  ACCESS_EXPIRED
  REVOKED
  DESTROYED
}

enum AccessAction {
  VIEW
  DOWNLOAD
  CONTROLLED_DOWNLOAD
}

enum AccessDecision {
  APPROVED
  DENIED
  APPROVAL_REQUIRED
  EXPIRED
  REVOKED
}

enum AccessSessionStatus {
  ACTIVE
  EXPIRED
  CLOSED
  REVOKED
}

enum ManagedCredentialStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AuditEventType {
  DISCOVERY
  CLASSIFICATION
  ENCRYPTION
  KEY_GENERATION
  STORAGE_WRITE
  ACCESS_REQUEST
  APPROVAL
  DENIAL
  SESSION_START
  SESSION_END
  REVOCATION
  DELETION
}

// User management and authentication
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(VIEWER)
  authSource    AuthSource @default(LOCAL)
  employeeId    String?   @unique
  department    String?
  clearanceLevel ClearanceLevel @default(L0_INTERNAL)
  projectMemberships String[] @default([])
  lastMfaAt     DateTime?
  breakGlass    Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  
  sessions      Session[]
  auditLogs     AuditLog[]
  accessRequests AccessRequest[]
  accessSessions AccessSession[]
  auditLedgerEvents AuditLedgerEvent[]
  systemControlUpdates SystemControl[]
  frozenAssets  Asset[]   @relation("AssetFrozenByUser")
  requestedApprovals AdminApproval[] @relation("ApprovalRequestedByUser")
  reviewedApprovals AdminApproval[] @relation("ApprovalReviewedByUser")
  updatedRiskRules AdminRiskRule[]
  serviceAccountProfile ServiceAccount?
  assignedManagedCredentials ManagedCredential[] @relation("ManagedCredentialAssignedUser")
  issuedManagedCredentials ManagedCredential[] @relation("ManagedCredentialIssuedByUser")
  revokedManagedCredentials ManagedCredential[] @relation("ManagedCredentialRevokedByUser")
}

enum UserRole {
  ADMIN
  SECURITY_ENGINEER
  VIEWER
}

model ServiceAccount {
  id                  String         @id @default(uuid())
  clientId            String         @unique
  displayName         String
  description         String?
  clientSecretHash    String
  role                UserRole       @default(VIEWER)
  clearanceLevel      ClearanceLevel @default(L0_INTERNAL)
  department          String?
  projectMemberships  String[]       @default([])
  allowedNetworkZones String[]       @default([])
  userId              String         @unique
  isActive            Boolean        @default(true)
  secretRotatedAt     DateTime?
  lastUsedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive, createdAt])
}

model ManagedCredential {
  id                  String                  @id @default(uuid())
  displayName         String
  assignedUserId      String
  deviceId            String
  deviceLabel         String?
  deviceKeyAlgorithm  String
  devicePublicKey     String
  devicePublicKeyHash String
  networkZone         NetworkZone             @default(UNKNOWN)
  locationLabel       String?
  locationCode        String?
  status              ManagedCredentialStatus @default(ACTIVE)
  issuedReason        String?
  revokedReason       String?
  expiresAt           DateTime?
  lastUsedAt          DateTime?
  issuedByUserId      String?
  revokedByUserId     String?
  metadata            Json?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  assignedUser        User                    @relation("ManagedCredentialAssignedUser", fields: [assignedUserId], references: [id], onDelete: Cascade)
  issuedByUser        User?                   @relation("ManagedCredentialIssuedByUser", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  revokedByUser       User?                   @relation("ManagedCredentialRevokedByUser", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([assignedUserId, status, createdAt])
  @@index([deviceId, status, createdAt])
  @@index([networkZone, status, createdAt])
  @@index([devicePublicKeyHash])
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  token        String    @unique
  authSource   AuthSource @default(LOCAL)
  idpSubject   String?
  mfaSatisfied Boolean   @default(false)
  stepUpSatisfied Boolean @default(false)
  deviceId     String?
  deviceCompliance DeviceComplianceStatus @default(UNKNOWN)
  deviceTrustLevel String?
  networkZone  NetworkZone @default(UNKNOWN)
  ipAddress    String?
  sessionClaims Json?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([deviceId])
}

model AuditLog {
  id           String    @id @default(uuid())
  userId       String?
  action       String
  resource     String?
  resourceId   String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime  @default(now())
  
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([timestamp])
  @@index([action])
}

model SystemControl {
  id              String    @id @default(uuid())
  controlKey      String    @unique
  label           String
  description     String?
  isEnabled       Boolean   @default(false)
  reason          String?
  metadata        Json?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  updatedByUser   User?     @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([controlKey])
  @@index([isEnabled])
  @@index([updatedAt])
}

// Scan targets and scans
model Target {
  id              String       @id @default(uuid())
  name            String
  type            TargetType
  host            String
  port            Int?
  protocol        String       @default("https")
  credentials     String?      // Vault reference
  metadata        Json?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  scans           Scan[]
  
  @@index([type])
  @@index([isActive])
}

enum TargetType {
  TLS_ENDPOINT
  DATABASE
  API_ENDPOINT
  FILE_STORAGE
}

model Scan {
  id              String       @id @default(uuid())
  targetId        String
  status          ScanStatus   @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  target          Target       @relation(fields: [targetId], references: [id], onDelete: Cascade)
  scanAssets      ScanAsset[]
  
  @@index([targetId])
  @@index([status])
  @@index([createdAt])
}

enum ScanStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model ScanAsset {
  id                    String    @id @default(uuid())
  scanId                String
  assetId               String?
  discoveryDetails      Json      // TLS handshake data, cert chain, etc.
  certificateChain      String?   // PEM encoded
  tlsVersion            String?
  cipherSuite           String?
  signatureAlgorithm    String?
  publicKeyAlgorithm    String?
  publicKeySize         Int?
  validFrom             DateTime?
  validUntil            DateTime?
  subjectAltNames       String[]
  commonName            String?
  isPqcCompliant        Boolean   @default(false)
  createdAt             DateTime  @default(now())
  
  scan                  Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  asset                 Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  
  @@index([scanId])
  @@index([assetId])
  @@index([isPqcCompliant])
}

// Asset management
model Asset {
  id                  String          @id @default(uuid())
  name                String
  type                AssetType
  fingerprint         String          @unique
  status              AssetStatus     @default(DISCOVERED)
  exposure            ExposureLevel   @default(INTERNAL)
  sensitivity         SensitivityLevel @default(MEDIUM)
  criticality         CriticalityLevel @default(MEDIUM)
  riskScore           Int             @default(0)
  riskLevel           RiskLevel       @default(UNKNOWN)
  metadata            Json?
  isFrozen            Boolean         @default(false)
  freezeReason        String?
  frozenAt            DateTime?
  frozenByUserId      String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  lastScannedAt       DateTime?
  
  scanAssets          ScanAsset[]
  assetKeyMaterial    AssetKeyMaterial?
  policyAssets        PolicyAsset[]
  wrappingResults     WrappingResult[]
  attestations        Attestation[]
  frozenByUser        User?           @relation("AssetFrozenByUser", fields: [frozenByUserId], references: [id], onDelete: SetNull)
  
  @@index([status])
  @@index([riskLevel])
  @@index([type])
  @@index([fingerprint])
  @@index([isFrozen])
  @@index([frozenByUserId])
}

model AdminApproval {
  id                String                 @id @default(uuid())
  operationType     AdminApprovalOperation
  resourceType      String
  resourceId        String?
  status            AdminApprovalStatus    @default(PENDING)
  reason            String?
  requestContext    Json?
  requestedByUserId String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  requestedByUser   User?                  @relation("ApprovalRequestedByUser", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  reviewedByUser    User?                  @relation("ApprovalReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  accessRequests    AccessRequest[]

  @@index([status, createdAt])
  @@index([operationType, resourceType, resourceId])
}

enum AdminApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminApprovalOperation {
  PIPELINE_TRANSFER
  WRAPPING_JOB
  ATTESTATION_SUBMISSION
  ACCESS_SESSION
}

model AdminRiskRule {
  id                         String     @id @default(uuid())
  ruleKey                    String     @unique @default("default")
  maxRiskScoreAutoApprove    Int        @default(70)
  requireApprovalAtRiskLevel RiskLevel  @default(HIGH)
  maxAssetsPerRun            Int        @default(1000)
  isActive                   Boolean    @default(true)
  updatedByUserId            String?
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  updatedByUser              User?      @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([isActive])
}

enum AssetType {
  TLS_CERTIFICATE
  API_KEY
  DATABASE_CREDENTIAL
  ENCRYPTION_KEY
  SIGNING_KEY
  SSH_KEY
  GENERIC_SECRET
}

enum AssetStatus {
  DISCOVERED
  ASSESSED
  WRAPPED_PQC
  ATTESTED
  ROTATED
  DECOMMISSIONED
}

enum ExposureLevel {
  PUBLIC
  INTERNAL
  RESTRICTED
  CONFIDENTIAL
}

enum SensitivityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CriticalityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskLevel {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Asset key material storage
model AssetKeyMaterial {
  id                String    @id @default(uuid())
  assetId           String    @unique
  vaultPath         String    // HashiCorp Vault path
  vaultVersion      Int       @default(1)
  keyType           String
  sizeBytes         Int?
  uploadedAt        DateTime  @default(now())
  metadata          Json?
  
  asset             Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  @@index([vaultPath])
}

// Policy management
model Policy {
  id                String          @id @default(uuid())
  name              String
  description       String?
  ruleDefinition    Json            // Policy rules and criteria
  targetScope       Json?           // Which assets this applies to
  isActive          Boolean         @default(false)
  priority          Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  activatedAt       DateTime?
  
  policyAssets      PolicyAsset[]
  wrappingJobs      WrappingJob[]
  
  @@index([isActive])
  @@index([priority])
}

model PolicyAsset {
  id                String    @id @default(uuid())
  policyId          String
  assetId           String
  evaluatedAt       DateTime  @default(now())
  result            Json?
  
  policy            Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  asset             Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  @@unique([policyId, assetId])
  @@index([policyId])
  @@index([assetId])
}

// Anchor key management
model Anchor {
  id                String      @id @default(uuid())
  name              String
  algorithm         String      // e.g., "Kyber1024"
  vaultKeyPath      String      // Path to public key in Vault
  vaultPrivKeyPath  String      // Path to private key in Vault
  isActive          Boolean     @default(true)
  rotatedAt         DateTime?
  createdAt         DateTime    @default(now())
  metadata          Json?
  
  wrappingResults   WrappingResult[]
  attestations      Attestation[]
  
  @@index([isActive])
  @@index([algorithm])
}

// Wrapping jobs and results
model WrappingJob {
  id                String          @id @default(uuid())
  policyId          String?
  status            JobStatus       @default(PENDING)
  totalAssets       Int             @default(0)
  processedAssets   Int             @default(0)
  failedAssets      Int             @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  errorMessage      String?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  policy            Policy?         @relation(fields: [policyId], references: [id], onDelete: SetNull)
  wrappingResults   WrappingResult[]
  
  @@index([status])
  @@index([createdAt])
}

enum JobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

model WrappingResult {
  id                String      @id @default(uuid())
  jobId             String?
  assetId           String
  anchorId          String
  kemCiphertext     String      // Base64 encoded
  nonce             String      // Base64 encoded
  aeadCiphertext    String      // Base64 encoded
  aeadTag           String      // Base64 encoded
  algorithm         String      // Full algorithm description
  vaultPath         String      // Where the wrapped result is stored
  wrappedAt         DateTime    @default(now())
  metadata          Json?
  
  job               WrappingJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  asset             Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  anchor            Anchor      @relation(fields: [anchorId], references: [id], onDelete: Restrict)
  
  @@index([jobId])
  @@index([assetId])
  @@index([anchorId])
}

// Attestation management
model AttestationJob {
  id                String          @id @default(uuid())
  status            JobStatus       @default(PENDING)
  totalAssets       Int             @default(0)
  processedAssets   Int             @default(0)
  failedAssets      Int             @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  errorMessage      String?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  attestations      Attestation[]
  
  @@index([status])
  @@index([createdAt])
}

model Attestation {
  id                String          @id @default(uuid())
  jobId             String?
  assetId           String
  anchorId          String
  attestationHash   String          // Hash submitted to blockchain
  txHash            String?         // Blockchain transaction hash
  blockNumber       BigInt?
  confirmations     Int             @default(0)
  chainId           Int?
  status            AttestationStatus @default(PENDING)
  submittedAt       DateTime?
  confirmedAt       DateTime?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  job               AttestationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  asset             Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  anchor            Anchor          @relation(fields: [anchorId], references: [id], onDelete: Restrict)
  
  @@index([jobId])
  @@index([assetId])
  @@index([txHash])
  @@index([status])
}

enum AttestationStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

// Organization snapshots for dashboard trends
model OrgSnapshot {
  id                    String    @id @default(uuid())
  timestamp             DateTime  @default(now())
  totalAssets           Int       @default(0)
  discoveredAssets      Int       @default(0)
  wrappedAssets         Int       @default(0)
  attestedAssets        Int       @default(0)
  criticalRiskAssets    Int       @default(0)
  highRiskAssets        Int       @default(0)
  mediumRiskAssets      Int       @default(0)
  lowRiskAssets         Int       @default(0)
  pqcCompliantPercent   Float     @default(0)
  avgRiskScore          Float     @default(0)
  metadata              Json?
  
  @@index([timestamp])
}

model PipelineRun {
  id               String       @id @default(uuid())
  status           PipelineRunStatus @default(IN_PROGRESS)
  sourceRoots      String[]
  destinationRoots String[]
  manifestSha      Json?
  startedAt        DateTime?    @default(now())
  completedAt      DateTime?
  totalFound       Int          @default(0)
  processed        Int          @default(0)
  skipped          Int          @default(0)
  failed           Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  assets           PipelineAsset[]

  @@index([status])
  @@index([startedAt])
}

enum PipelineRunStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model PipelineAsset {
  id                    String              @id @default(uuid())
  runId                 String
  objectId              String?
  relativePath          String
  sourcePath            String
  destinationPath       String?
  status                PipelineAssetStatus @default(IDENTIFIED)
  pqcStatus             String?
  pqcProtected          Boolean             @default(false)
  dataDomain            String?
  cryptoDomain          String?
  expectedPolicyOutcome String?
  plaintextSha256       String?
  manifestSha256        String?
  fileSizeBytes         Int?
  nistLevel             Int?
  metadata              Json?
  classificationLevel   ClassificationLevel @default(L0_INTERNAL)
  ownerDepartment       String?
  storageLocation       String?
  encryptionState       EncryptionState     @default(UNENCRYPTED)
  keyManifestRef        String?
  authorizedRoles       String[]            @default([])
  retentionPolicy       String?
  lifecycleState        AssetLifecycleState @default(DISCOVERED)
  integrityCheckTimestamp DateTime?
  legalHold             Boolean             @default(false)
  legalHoldReason       String?
  approvalRequired      Boolean             @default(false)
  lastAccessAt          DateTime?
  accessHistoryRef      String?
  stageTimestamps       Json?
  errorMessage          String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  run                   PipelineRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  accessRequests        AccessRequest[]
  accessSessions        AccessSession[]
  auditLedgerEvents     AuditLedgerEvent[]

  @@index([runId])
  @@index([status])
  @@index([pqcProtected])
  @@index([classificationLevel])
  @@index([lifecycleState])
  @@index([legalHold])
}

model AccessRequest {
  id                    String              @id @default(uuid())
  pipelineAssetId       String
  requesterUserId       String
  requestedAction       AccessAction
  requestedTtlSeconds   Int
  decision              AccessDecision
  decisionReason        String?
  policyVersion         String
  policyHash            String
  classificationLevel   ClassificationLevel
  requesterClearanceLevel ClearanceLevel
  requesterDepartment   String?
  requesterRole         String?
  requesterProjects     String[]            @default([])
  deviceId              String?
  deviceCompliance      DeviceComplianceStatus @default(UNKNOWN)
  networkZone           NetworkZone         @default(UNKNOWN)
  approvalId            String?
  approvalHash          String?
  requestedAt           DateTime            @default(now())
  decidedAt             DateTime?
  expiresAt             DateTime?
  context               Json?

  pipelineAsset         PipelineAsset       @relation(fields: [pipelineAssetId], references: [id], onDelete: Cascade)
  requesterUser         User                @relation(fields: [requesterUserId], references: [id], onDelete: Cascade)
  approval              AdminApproval?      @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  accessSession         AccessSession?
  auditLedgerEvents     AuditLedgerEvent[]

  @@index([pipelineAssetId, requestedAt])
  @@index([requesterUserId, requestedAt])
  @@index([decision, requestedAt])
  @@index([approvalId])
}

model AccessSession {
  id                    String              @id @default(uuid())
  accessRequestId       String              @unique
  pipelineAssetId       String
  requesterUserId       String
  sessionTokenHash      String              @unique
  wrapKeyVaultPath      String
  rewrappedKeyNonce     String
  rewrappedKeyCiphertext String
  rewrappedKeyTag       String
  rewrapAlgorithm       String
  contentHash           String
  allowedAction         AccessAction
  status                AccessSessionStatus @default(ACTIVE)
  expiresAt             DateTime
  closedAt              DateTime?
  revokedAt             DateTime?
  lastAccessAt          DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  blockchainTxHash      String?
  blockchainBlockNumber BigInt?
  metadata              Json?

  accessRequest         AccessRequest       @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)
  pipelineAsset         PipelineAsset       @relation(fields: [pipelineAssetId], references: [id], onDelete: Cascade)
  requesterUser         User                @relation(fields: [requesterUserId], references: [id], onDelete: Cascade)
  auditLedgerEvents     AuditLedgerEvent[]

  @@index([pipelineAssetId, status, expiresAt])
  @@index([requesterUserId, status, expiresAt])
}

model AuditLedgerEvent {
  id                    String              @id @default(uuid())
  eventType             AuditEventType
  action                String
  result                String
  pipelineAssetId       String?
  accessRequestId       String?
  accessSessionId       String?
  userId                String?
  role                  String?
  deviceId              String?
  location              String?
  networkZone           NetworkZone?
  policyVersion         String?
  policyHash            String?
  assetHash             String?
  previousEventHash     String?
  eventHash             String              @unique
  signatureAlgorithm    String
  digitalSignature      String
  blockchainTxHash      String?
  blockchainBlockNumber BigInt?
  payload               Json
  createdAt             DateTime            @default(now())

  pipelineAsset         PipelineAsset?      @relation(fields: [pipelineAssetId], references: [id], onDelete: SetNull)
  accessRequest         AccessRequest?      @relation(fields: [accessRequestId], references: [id], onDelete: SetNull)
  accessSession         AccessSession?      @relation(fields: [accessSessionId], references: [id], onDelete: SetNull)
  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([pipelineAssetId, createdAt])
  @@index([accessRequestId, createdAt])
  @@index([accessSessionId, createdAt])
  @@index([eventType, createdAt])
  @@index([userId, createdAt])
}

enum PipelineAssetStatus {
  IDENTIFIED
  CATEGORIZED
  ANALYZED
  NIST_ASSIGNED
  SKIPPED
  WRAPPED_PQC
  TRANSFERRED
  FAILED
}
