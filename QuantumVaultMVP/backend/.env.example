# Database
DATABASE_URL="postgresql://quantumvault:changeme@127.0.0.1:55432/quantumvault?schema=public"

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=replace-with-strong-jwt-secret
JWT_EXPIRES_IN=24h
AUTH_COOKIE_SECURE=false

# Enterprise Identity Federation (internal-only)
ENTERPRISE_IDP_PROVIDER=azure_ad
ENTERPRISE_IDP_JWKS_URL=
ENTERPRISE_IDP_ISSUER=
ENTERPRISE_IDP_AUDIENCE=
ENTERPRISE_STEP_UP_JWKS_URL=
ENTERPRISE_STEP_UP_ISSUER=
ENTERPRISE_STEP_UP_AUDIENCE=
DEVICE_ATTESTATION_JWKS_URL=
DEVICE_ATTESTATION_ISSUER=
DEVICE_ATTESTATION_AUDIENCE=

# Redis (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# HashiCorp Vault (REQUIRED)
VAULT_ADDR=http://localhost:8200
VAULT_AUTH_METHOD=approle
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# Optional fallback for local development only when VAULT_AUTH_METHOD=token
VAULT_TOKEN=
VAULT_NAMESPACE=quantumvault

# Blockchain
ANCHORING_BACKEND=evm
# For ANCHORING_BACKEND=dytallix
DYTALLIX_API_URL=https://dytallix.example.com
DYTALLIX_API_TOKEN=
BLOCKCHAIN_RPC_URL=http://localhost:8545
# Optional: live network status endpoint used for admin KPI health (latest height/peers/sync).
BLOCKCHAIN_STATUS_URL=
BLOCKCHAIN_PRIVATE_KEY=replace-with-non-default-private-key
# Optional for local geth dev networks with node-managed unlocked accounts.
BLOCKCHAIN_FROM_ADDRESS=
BLOCKCHAIN_CHAIN_ID=1337
ATTESTATION_CONTRACT_ADDRESS=

# TLS Scanner
TLS_SCAN_TIMEOUT=30000
TLS_SCAN_CONCURRENT_LIMIT=5

# PQC Wrapping
PQC_ALGORITHM=ML-KEM-1024
PQC_SYMMETRIC_CIPHER=AES-256-GCM

# Object Storage
STORAGE_BACKEND=filesystem
STORAGE_FILESYSTEM_ROOT=
OBJECT_STORAGE_BUCKET=quantumvault
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=

# Key Governance (90-day hardening)
# Set these to false after initial key provisioning in production.
ATTESTATION_KEY_BOOTSTRAP_ALLOWED=true
TRANSPORT_KEYS_BOOTSTRAP_ALLOWED=true
# Optional key pinning controls (recommended in production).
ATTESTATION_SIGNER_KEY_ID_PIN=
ATTESTATION_SIGNER_KEY_HASH_PIN=
TRANSPORT_KEM_KEY_ID_PIN=
TRANSPORT_KEM_KEY_HASH_PIN=
TRANSPORT_IDENTITY_KEY_ID_PIN=
TRANSPORT_IDENTITY_KEY_HASH_PIN=

# Logging
LOG_LEVEL=info

# Internal Secure Access
# Comma-separated audit event types to anchor on-chain. Leave blank for default high-value access events.
ACCESS_AUDIT_ANCHOR_EVENTS=
SIEM_EXPORT_ENABLED=false
SIEM_EXPORT_URL=
SIEM_EXPORT_FORMAT=json
SIEM_EXPORT_AUTH_TOKEN=
SIEM_EXPORT_TIMEOUT_MS=5000

# Monitoring
# Used by Prometheus or other internal scrapers when hitting /api/v1/monitoring/*
MONITORING_BEARER_TOKEN=
