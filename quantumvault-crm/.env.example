# ============================================
# QuantumVault CRM - Environment Variables
# ============================================
# Copy this to .env.local and fill in your values

# ─── PostgreSQL ───────────────────────────────
# Hetzner example:
# postgresql://quantumvault:strong_password@127.0.0.1:5432/quantumvault_crm
DATABASE_URL=postgresql://crm_user:change_me@127.0.0.1:5432/quantumvault_crm
# Set to true only if your PostgreSQL server requires TLS.
DATABASE_SSL=false

# ─── Google OAuth (Gmail + Calendar) ──────────
# Get these from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Local:  http://localhost:3000/api/auth/gmail/callback
# Prod:   https://dytallix.com/qvcrm/api/auth/gmail/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# ─── LinkedIn (Phase 4 - optional for now) ────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://dytallix.com/api/auth/linkedin/callback

# ─── App Config ───────────────────────────────
# Prod app URL remains the root origin. Base path carries the /qvcrm mount.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=
JWT_SECRET=generate_a_random_64_char_string_here
