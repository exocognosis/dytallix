server {
    server_name dytallix.com www.dytallix.com;
    
    root /usr/share/nginx/html;
    index index.html;
    
    # Proxy QuantumVault API requests (fixed port to 3031)
    location /quantumvault/ {
        proxy_pass http://127.0.0.1:3031/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        add_header Access-Control-Allow-Origin * always;
    }
    
    # Alternative route with /api/ prefix for quantumvault
    location /api/quantumvault/ {
        proxy_pass http://127.0.0.1:3031/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    # Quantum Risk API proxy
    location /api/quantum-risk/ {
        proxy_pass http://127.0.0.1:8787/api/quantum-risk/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }

    # Blockchain API (Proxies /api/blockchain/* to localhost:3030/*)
    location /api/blockchain/ {
        rewrite ^/api/blockchain/(.*) /$1 break;
        proxy_pass http://127.0.0.1:3030;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
    
    # Proxy RPC requests to blockchain node
    location /rpc/ {
        proxy_pass http://127.0.0.1:3030/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    # Direct blockchain endpoints for Explorer (frontend expects these without /api/ prefix)
    location = /status {
        proxy_pass http://127.0.0.1:3030/status;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    location /blocks {
        proxy_pass http://127.0.0.1:3030/blocks;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    location /transactions {
        proxy_pass http://127.0.0.1:3030/transactions;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    location /block/ {
        proxy_pass http://127.0.0.1:3030/block/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    location /tx/ {
        proxy_pass http://127.0.0.1:3030/tx/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    location /account/ {
        proxy_pass http://127.0.0.1:3030/account/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    location /balance/ {
        proxy_pass http://127.0.0.1:3030/balance/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    location /metrics {
        proxy_pass http://127.0.0.1:3030/metrics;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    # Main API server (port 8787)
    # Faucet endpoints are isolated to reduce 502 spikes during main API restarts.
    location /api/faucet/ {
        proxy_pass http://127.0.0.1:3004/api/faucet/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_next_upstream error timeout invalid_header http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        add_header Access-Control-Allow-Origin * always;
    }

    # Legacy faucet path compatibility (/faucet/request, /faucet/status).
    location /faucet/ {
        proxy_pass http://127.0.0.1:3004/api/faucet/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_next_upstream error timeout invalid_header http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        add_header Access-Control-Allow-Origin * always;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8787/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_next_upstream error timeout invalid_header http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        add_header Access-Control-Allow-Origin * always;
    }

    # QuantumVault MVP backend API
    location /api/v1 {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # QuantumVault MVP frontend (Next.js)
    location = /QuantumVaultMVP {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    location ^~ /QuantumVaultMVP/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
    
    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|wasm)$ {
        expires 1y;
        add_header Cache-Control 'public, immutable';
    }
    
    # SPA routing - serve index.html for all routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    listen [::]:443 ssl ipv6only=on;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/dytallix.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dytallix.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# Redirect HTTP to HTTPS for domain requests ONLY
server {
    if ($host = www.dytallix.com) {
        return 301 https://$host$request_uri;
    }

    if ($host = dytallix.com) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    listen [::]:80;
    server_name dytallix.com www.dytallix.com;
}

# Localhost server block for internal Playwright PDF generation
# This is now the default server for IP-based or localhost requests
server {
    listen 80 default_server;
    server_name localhost 127.0.0.1;
    
    root /usr/share/nginx/html;
    index index.html;
    
    location / {
        try_files $uri $uri/ /index.html;
    }
}
