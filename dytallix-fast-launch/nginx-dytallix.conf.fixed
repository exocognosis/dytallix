server {
    server_name dytallix.com www.dytallix.com;
    
    root /usr/share/nginx/html;
    index index.html;

    # Legacy public QuantumVault path now maps to Enterprise frontend route.
    location /quantumvault/ {
        return 301 /enterprise;
    }
    
    # Alternative route with /api/ prefix for quantumvault
    location /api/quantumvault/ {
        proxy_pass http://127.0.0.1:3031/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    # Quantum Risk API proxy
    location /api/quantum-risk/ {
        proxy_pass http://127.0.0.1:8787/api/quantum-risk/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }

    # Blockchain API (Proxies /api/blockchain/* to localhost:3030/*)
    location /api/blockchain/ {
        rewrite ^/api/blockchain/(.*) /$1 break;
        proxy_pass http://127.0.0.1:3030;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
    
    # Proxy RPC requests to blockchain node
    location /rpc/ {
        proxy_pass http://127.0.0.1:3030/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    # Direct blockchain endpoints for Explorer (frontend expects these without /api/ prefix)
    location = /status {
        proxy_pass http://127.0.0.1:3030/status;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    location /blocks {
        proxy_pass http://127.0.0.1:3030/blocks;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    location /transactions {
        proxy_pass http://127.0.0.1:3030/transactions;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    location /block/ {
        proxy_pass http://127.0.0.1:3030/block/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    location /tx/ {
        proxy_pass http://127.0.0.1:3030/tx/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    location /account/ {
        proxy_pass http://127.0.0.1:3030/account/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    location /balance/ {
        proxy_pass http://127.0.0.1:3030/balance/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    location /metrics {
        proxy_pass http://127.0.0.1:3030/metrics;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Access-Control-Allow-Origin * always;
    }
    
    # Main API server (port 8787)
    # Faucet endpoints are isolated to reduce 502 spikes during main API restarts.
    location /api/faucet/ {
        proxy_pass http://127.0.0.1:8787/api/faucet/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_next_upstream error timeout invalid_header http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        add_header Access-Control-Allow-Origin * always;
    }

    # Legacy faucet path compatibility (/faucet/request, /faucet/status).
    location /faucet/ {
        proxy_pass http://127.0.0.1:8787/api/faucet/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_next_upstream error timeout invalid_header http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        add_header Access-Control-Allow-Origin * always;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8787/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_next_upstream error timeout invalid_header http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        add_header Access-Control-Allow-Origin * always;
    }

    # QuantumVault MVP backend API.
    # The Hetzner deploy flow does not start these services from
    # dytallix-fast-launch/ecosystem.config.cjs; it reuses the standalone
    # QuantumVault deployment that listens on 13000/13002.
    location /api/v1 {
        proxy_pass http://127.0.0.1:13000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # Normalize mixed-case entry URLs to the canonical QuantumVault login route.
    location ~* ^/quantumvaultmvp/?$ {
        return 301 /QuantumVaultMVP/login$is_args$args;
    }

    location ~* ^/quantumvaultmvp/login/?$ {
        return 301 /QuantumVaultMVP/login$is_args$args;
    }

    # Namespaced QuantumVault MVP API for builds that call the app-scoped path.
    location = /QuantumVaultMVP/api/v1 {
        return 301 /QuantumVaultMVP/api/v1/;
    }

    location ^~ /QuantumVaultMVP/api/v1/ {
        proxy_pass http://127.0.0.1:13000/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache_bypass $http_upgrade;
    }

    # QuantumVault MVP frontend (Next.js)
    location = /QuantumVaultMVP {
        proxy_pass http://127.0.0.1:13002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    location ^~ /QuantumVaultMVP/ {
        proxy_pass http://127.0.0.1:13002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # QuantumVault CRM (Next.js) under /qvcrm
    location = /QVCRM {
        return 301 /qvcrm/login;
    }

    location = /QVCRM/ {
        return 301 /qvcrm/login;
    }

    # Proxy the bare basePath directly to avoid an nginx <-> Next.js trailing-slash redirect loop.
    location = /qvcrm {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location ^~ /qvcrm/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
    
    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|wasm)$ {
        expires 1y;
        add_header Cache-Control 'public, immutable';
    }
    
    # SPA routing - serve index.html for all routes
    location / {
        try_files $uri /index.html;
    }

    listen [::]:443 ssl ipv6only=on;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/dytallix.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dytallix.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# Redirect HTTP to HTTPS for domain requests ONLY
server {
    if ($host = www.dytallix.com) {
        return 301 https://$host$request_uri;
    }

    if ($host = dytallix.com) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    listen [::]:80;
    server_name dytallix.com www.dytallix.com;
}

# Localhost server block for internal Playwright PDF generation
# This is now the default server for IP-based or localhost requests
server {
    listen 80 default_server;
    server_name localhost 127.0.0.1;
    
    root /usr/share/nginx/html;
    index index.html;
    
    location / {
        try_files $uri /index.html;
    }
}
