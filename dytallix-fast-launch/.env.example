# =====================
# Frontend (using VITE_* naming for build-time availability)
# =====================
REACT_APP_API_BASE_URL=https://api.dytallix.com
REACT_APP_DEV_MODE=false
REACT_APP_NODE_URL=https://rpc.dytallix.com
REACT_APP_EXPLORER_URL=https://explorer.dytallix.com

# =====================
# Runtime Environment - UNIFIED PORT SCHEME
# =====================
NODE_ENV=production
PORT=3001
ALLOWED_ORIGIN=https://app.dytallix.com

# Development Ports (SINGLE SOURCE OF TRUTH)
FRONTEND_PORT=3000
BACKEND_API_PORT=3001
QUANTUMVAULT_API_PORT=3002
BLOCKCHAIN_NODE_PORT=3003
WEBSOCKET_PORT=3004
FAUCET_PORT=3004

# =====================
# Cosmos Chain Configuration
# =====================
VITE_LCD_HTTP_URL=https://lcd.dytallix.com
VITE_RPC_HTTP_URL=https://rpc.dytallix.com
VITE_RPC_WS_URL=wss://rpc.dytallix.com/websocket
VITE_CHAIN_ID=dytallix-mainnet
CHAIN_PREFIX=dytallix
RPC_HTTP_URL=https://rpc.dytallix.com

# =====================
# API and Faucet Configuration (new unified pattern)
# =====================
VITE_API_URL=https://api.dytallix.com/api
# VITE_FAUCET_URL=https://api.dytallix.com/api/faucet  # Optional explicit override

# =====================
# Faucet Signer (DO NOT USE production mnemonics in dev/test)
# =====================
# FAUCET_MNEMONIC="your test mnemonic here - NEVER commit real mnemonics"
FAUCET_GAS_PRICE=0.025uDRT
FAUCET_MAX_PER_REQUEST_DGT=2
FAUCET_MAX_PER_REQUEST_DRT=50
FAUCET_COOLDOWN_MINUTES=60

# =====================
# Rate Limiting with Redis (Optional)
# =====================
# DLX_RATE_LIMIT_REDIS_URL=redis://localhost:6379
# Leave unset to use in-memory rate limiting

# =====================
# Security Feature Flags
# =====================
ENABLE_SEC_HEADERS=1
ENABLE_CSP=1

# =====================
# Node Block Producer (Rust devnet)
# =====================
DYT_BLOCK_INTERVAL_MS=2000
DYT_EMPTY_BLOCKS=true
BLOCK_MAX_TX=100
DYT_WS_ENABLED=true
DYT_DATA_DIR=./data
DYT_CHAIN_ID=dytallix-testnet-1
RUNTIME_MOCKS=false

# =====================
# Governance Parameters
# (CLI fallback if flags not provided; maps to dcli --gov.* flags)
# =====================
GOV_QUORUM=0.33
GOV_THRESHOLD=0.50
GOV_VETO=0.334
GOV_PROPOSAL_DEPOSIT=1000000
GOV_MIN_VOTE_DURATION=3600
GOV_MAX_VOTE_DURATION=86400
GOV_VETO_THRESHOLD=0.334

# =====================
# QuantumVault API Configuration
# =====================
VITE_QUANTUMVAULT_API_URL=https://quantumvault.dytallix.com
BLOCKCHAIN_API_URL=https://rpc.dytallix.com

# =====================
# Aegis Oracle Attestation + Relayer
# =====================
AEGIS_MODEL_ID=aegis-heuristic-v1
AEGIS_ORACLE_ID=aegis-primary
AEGIS_RELAYER_ID=aegis-relayer
AEGIS_ATTESTATION_TTL_SEC=300
AEGIS_ESCALATION_CONFIDENCE=0.9
AEGIS_ORACLE_RELAY_ENABLED=true
AEGIS_ORACLE_BATCH_PATH=/oracle/ai_risk_batch
# Optional: set stable ML-DSA-87 signer keys for deterministic on-chain verification
# AEGIS_ORACLE_SK_B64=
# AEGIS_ORACLE_PK_B64=
# Optional: persisted key file (used when env keys are not set)
# AEGIS_ORACLE_KEYS_FILE=./data/aegis-oracle-keys.json
# Optional: use prebuilt signer binary instead of cargo run
# AEGIS_PQC_SIGNER_BIN=./node/target/release/pqc_signer

# Rust node oracle attestation policy
DYT_ORACLE_TX_THROTTLE_SOFT=0.70
DYT_ORACLE_TX_THROTTLE_HARD=0.90
DYT_ORACLE_REVIEW_THRESHOLD=0.70
DYT_REQUIRE_AUDIT_ATTESTATION=true
DYT_GARRISON_DEPLOY_MIN_SCORE=0.75

# AI service oracle key persistence
# AI_ORACLE_KEYS_FILE=./data/ai-oracle-keys.json
# AI_ATTESTATION_TTL_SEC=300

# Garrison agentic compliance runtime
GARRISON_AGENT_ENABLED=true
GARRISON_AI_SERVICE_URL=http://127.0.0.1:7001
GARRISON_AI_TIMEOUT_MS=10000
GARRISON_AGENT_INTERVAL_MS=30000
GARRISON_MAX_JOBS_PER_CYCLE=8
GARRISON_AUTO_REMEDIATE=true
GARRISON_MAX_RETAINED_JOBS=400
GARRISON_MAX_RECENT_RUNS=120

# Horizon network/DeFi monitor runtime
HORIZON_AGENT_ENABLED=true
HORIZON_POLL_INTERVAL_MS=30000
HORIZON_ONCHAIN_RELAY_ENABLED=true
HORIZON_ATTESTATION_TTL_SEC=900
HORIZON_MODEL_ID=horizon-monitor-v1
HORIZON_ORACLE_ID=horizon-primary
HORIZON_RELAYER_ID=horizon-relayer
HORIZON_BRIDGE_MIN_VALIDATORS=3
HORIZON_BRIDGE_PENDING_THRESHOLD=25
HORIZON_BRIDGE_CUSTODY_SPIKE_PCT=0.30
HORIZON_POOL_DRAIN_THRESHOLD_PCT=0.20
HORIZON_MEMPOOL_HIGH_WATERMARK=250
HORIZON_MEMPOOL_CONCENTRATION_THRESHOLD=0.35
HORIZON_MEMPOOL_CONCENTRATION_MIN_COUNT=12
HORIZON_AUTO_BRIDGE_HALT=true
HORIZON_AUTO_BRIDGE_RESUME=true
HORIZON_BRIDGE_HALT_TTL_SEC=900
HORIZON_AUTO_WALLET_THROTTLE=true
HORIZON_AUTO_GOVERNANCE_PROPOSAL=true
HORIZON_GOV_PROPOSAL_COOLDOWN_SEC=21600
HORIZON_GOV_MAX_GAS_REDUCTION_PCT=0.20
HORIZON_GOV_GAS_LIMIT_REDUCTION_PCT=0.25

# Horizon notifications (Slack + email)
HORIZON_NOTIFY_ENABLED=true
HORIZON_NOTIFY_MIN_SEVERITY=high
HORIZON_SLACK_WEBHOOK_URL=
HORIZON_SLACK_TIMEOUT_MS=5000
HORIZON_NOTIFY_EMAIL_TO=
HORIZON_NOTIFY_EMAIL_FROM=noreply@dytallix.com

# =====================
# Notes
# - Copy to .env for local development.
# - Never commit real mnemonics or secrets.
# - Prefer VITE_* prefix for variables needed in frontend build.
# =====================
# See web/.env.example for frontend specific WS / API base variables
